+  auto record_called_function_type_as_user =
+      [&GlobalConstFuncTyMap](Value *gv, CallInst *call) {
+        // Find argument index.
+        unsigned index = 0;
+        for (unsigned i = 0; i < call->arg_size(); i++) {
