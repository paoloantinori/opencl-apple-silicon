+      nullptr, GV->getThreadLocalMode(), AddressSpace::ModuleScopePrivate);
+  NewGV->takeName(GV);
+
+  const SmallVector<User *, 8> GVUsers(GV->user_begin(), GV->user_end());
+  SmallVector<User *, 8> CandidateUsers;
